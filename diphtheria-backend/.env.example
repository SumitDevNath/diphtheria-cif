
# PostgreSQL - supply your own local values
DB_HOST=localhost
DB_PORT=5432
DB_NAME=diphtheria_cif_dev
DB_USER=diphtheria_cif_app
DB_PASSWORD=12345678

# React development origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum request body size (2 MiB)
MAX_REQUEST_BODY_BYTES=2097152

# Confirmed DGHS development authentication validator
DGHS_AUTH_VALIDATE_URL=https://dev.surveillance.dghs.gov.bd/api/auth/api/v1/auth/validate